// Cifra la omisión para que viaje con la respuesta sin que el participante pueda leerla.
const crypto = require("crypto");

function key() {
  return crypto.createHash("sha256").update("omision:" + (process.env.ANTHROPIC_API_KEY || "")).digest();
}

function seal(text) {
  const iv = crypto.randomBytes(12);
  const c = crypto.createCipheriv("aes-256-gcm", key(), iv);
  const enc = Buffer.concat([c.update(String(text), "utf8"), c.final()]);
  return Buffer.concat([iv, c.getAuthTag(), enc]).toString("base64url");
}

function open(token) {
  const buf = Buffer.from(String(token), "base64url");
  if (buf.length < 29) throw new Error("token");
  const d = crypto.createDecipheriv("aes-256-gcm", key(), buf.subarray(0, 12));
  d.setAuthTag(buf.subarray(12, 28));
  return Buffer.concat([d.update(buf.subarray(28)), d.final()]).toString("utf8");
}

module.exports = { seal, open };
